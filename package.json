{
  "name": "callmiracle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev-ssl": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 next dev --turbopack --experimental-https --experimental-https-key ./certs/localhost-key.pem --experimental-https-cert ./certs/localhost.pem",
    "debug-dev-ssl": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 next dev --experimental-https --experimental-https-key ./certs/localhost-key.pem --experimental-https-cert ./certs/localhost.pem",
    "dev-fast": "next dev --turbopack",
    "dev": "dotenv -e .env.observability -- cross-env NODE_OPTIONS='--inspect' next dev -p 3003",
    "build": "next build",
    "start": "next start",
    "debug-prod": "cross-env NODE_OPTIONS='--inspect-brk' next start",
    "lint": "next lint",
    "start:graphql": "ts-node src/server/index.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "observability:up": "docker-compose -f docker-compose.observability.yml up -d",
    "observability:down": "docker-compose -f docker-compose.observability.yml down",
    "observability:logs": "docker-compose -f docker-compose.observability.yml logs -f",
    "observability:restart": "yarn observability:down && yarn observability:up",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app",
    "docker:restart": "docker-compose restart app",
    "scale:up": "docker-compose -f docker-compose.scale.yml up -d",
    "scale:down": "docker-compose -f docker-compose.scale.yml down",
    "scale:logs": "docker-compose -f docker-compose.scale.yml logs -f",
    "scale:restart": "yarn scale:down && yarn scale:up",
    "scale:logs:app1": "docker-compose -f docker-compose.scale.yml logs -f app1",
    "scale:logs:app2": "docker-compose -f docker-compose.scale.yml logs -f app2",
    "scale:logs:app3": "docker-compose -f docker-compose.scale.yml logs -f app3",
    "scale:logs:nginx": "docker-compose -f docker-compose.scale.yml logs -f nginx",
    "scale:logs:redis": "docker-compose -f docker-compose.scale.yml logs -f redis",
    "test:observability": "node --loader ts-node/esm -e \"import('./src/utils/observabilityTest.ts').then(m => m.runObservabilityTests())\""
  },
  "dependencies": {
    "@apollo/client": "^3.12.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@graphql-yoga/plugin-graphql-sse": "^3.10.10",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@mui/material-nextjs": "^6.3.1",
    "@next-auth/mongodb-adapter": "^1.1.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.203.0",
    "@opentelemetry/auto-instrumentations-node": "^0.62.0",
    "@opentelemetry/core": "^2.0.1",
    "@opentelemetry/exporter-jaeger": "^2.0.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.203.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.203.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@opentelemetry/instrumentation": "^0.203.0",
    "@opentelemetry/instrumentation-express": "^0.52.0",
    "@opentelemetry/instrumentation-graphql": "^0.51.0",
    "@opentelemetry/instrumentation-http": "^0.203.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-logs": "^0.203.0",
    "@opentelemetry/sdk-metrics": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.203.0",
    "@opentelemetry/sdk-trace-base": "^2.0.1",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@opentelemetry/winston-transport": "^0.14.0",
    "@types/ioredis": "^5.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/uuid": "^10.0.0",
    "apollo-server": "^3.13.0",
    "apollo-server-micro": "^3.13.0",
    "bcrypt": "^5.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.7",
    "firebase": "^11.9.0",
    "graphql": "^16.10.0",
    "graphql-redis-subscriptions": "^2.7.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-yoga": "^5.10.9",
    "ioredis": "^5.6.1",
    "js-cookie": "^3.0.5",
    "mongodb": "^6.12.0",
    "next": "15.1.4",
    "next-auth": "^4.24.11",
    "next-intl": "^3.26.3",
    "nodemailer": "^7.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "sass": "^1.87.0",
    "sharp": "^0.33.5",
    "use-sync-external-store": "^1.5.0",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-loki": "^6.1.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@graphql-codegen/cli": "5.0.3",
    "@graphql-codegen/client-preset": "4.5.1",
    "@graphql-codegen/introspection": "4.0.3",
    "@graphql-codegen/typescript": "^4.1.2",
    "@graphql-codegen/typescript-operations": "^4.4.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.1.4",
    "graphql-tag": "^2.12.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "winston-elasticsearch": "^0.19.0"
  }
}
